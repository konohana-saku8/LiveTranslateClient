<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/overlay_header"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:id="@+id/overlay_drag_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/overlay_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/overlay_title"
                android:textColor="@color/text_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlay_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="monospace"
                android:text="@string/overlay_status_idle"
                android:textColor="@color/status_off"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_clear"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:background="@drawable/bg_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="36dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/overlay_btn_clear"
            android:textColor="@color/text_title"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="36dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/overlay_btn_settings"
            android:textColor="@color/text_title"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_stop"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="36dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/overlay_btn_stop"
            android:textColor="@color/text_error"
            android:textSize="11sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/overlay_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:scrollbars="vertical" />

    <FrameLayout
        android:id="@+id/overlay_footer"
        android:layout_width="match_parent"
        android:layout_height="18dp">

        <TextView
            android:id="@+id/overlay_grip"
            android:layout_width="20dp"
            android:layout_height="18dp"
            android:layout_gravity="end|bottom"
            android:gravity="center"
            android:text="◢"
            android:textColor="@color/text_timestamp"
            android:textSize="11sp" />
    </FrameLayout>
</LinearLayout>
